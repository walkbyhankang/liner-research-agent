# 이 파일을 `.env` 로 복사한 뒤 자신의 키를 입력하세요.   cp .env.example .env
# `.env` 는 .gitignore 로 제외되어 있으며 절대 커밋하지 않습니다. 키 값을 이 파일에 적지 마세요.
#
# 키가 비어 있으면 해당 API 를 쓰는 분석만 건너뛰고(화면에 "미확보"로 표시) 나머지 분석은 계속됩니다.

# ---------------------------------------------------------------------------
# [필수] Liner API 키 — https://platform.liner.com
#   통합 분석: 기업 프로필·경쟁사·기술 키워드 도출, 뉴스 보완 검색·요약, 논문 요약, 학술 검색(Scholar)
#   펀딩노트: 회사 조회, 공고문 자격 대조, 운용사 요약 / 기존 Streamlit 검증 화면(app_legacy.py)
LINER_API_KEY=

# ---------------------------------------------------------------------------
# [권장] 공공데이터포털(data.go.kr) 일반 인증키 — 하나의 키로 아래 API 를 함께 씁니다(각 API 활용신청 필요)
#   금융위원회 기업기본정보(GetCorpBasicInfoService_V2), 금융위원회 기업재무정보(GetFinaStatInfoService_V2),
#   국민연금 사업장 가입자 정보(NpsBplcInfoInqireServiceV2), 조달청 나라장터 입찰공고(BidPublicInfoService02)
#   없으면: 기업 식별번호·재무·고용·나라장터 공고가 미확보로 표시됩니다.
DATA_GO_KR_SERVICE_KEY=

# [권장] NAVER 검색 API(뉴스) — https://developers.naver.com
#   없으면: 뉴스는 Liner 웹 검색 결과만 표시됩니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# [선택] OpenAlex API 키 — 없어도 공개 API 로 동작합니다(키가 있으면 Authorization 헤더로만 전송).
OPENALEX_API_KEY=

# ---------------------------------------------------------------------------
# [선택] 공공 데이터 스냅샷 재생성용 — scripts/fetch_public_data.py 를 실행할 때만 씁니다.
#   저장소에 web/public/data/ 스냅샷이 포함되어 있어 통합 분석·펀딩노트 실행에는 없어도 됩니다.
# 기업마당 지원사업정보 API (https://www.bizinfo.go.kr)
BIZINFO_API_KEY=
# 한국벤처투자 펀드현황 API (https://www.kvic.or.kr)
KVIC_API_KEY=

# ---------------------------------------------------------------------------
# 참고: 아래 값은 .env 가 아니라 셸 환경변수로 읽습니다(키 아님, 기본값이 있어 설정하지 않아도 됩니다).
#   FUNDING_MAX_PAID_CALLS=60      펀딩노트 FastAPI 서버의 실행당 유료 호출 상한(api/main.py)
#   FUNDING_WEB_ORIGINS=...        FastAPI CORS 허용 주소(api/main.py)
#   FUNDING_WEB_PORT=3100 FUNDING_API_PORT=8000 STREAMLIT_PORT=8501   scripts/run_local.sh 포트
