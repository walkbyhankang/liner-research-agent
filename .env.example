# 이 파일을 `.env` 로 복사한 뒤 실제 키를 입력하세요.  cp .env.example .env
# `.env` 는 .gitignore 로 제외되어 있으며 절대 커밋하지 않습니다.
#
# Liner API 키 (https://platform.liner.com 에서 발급)
LINER_API_KEY=your-liner-api-key-here

# 공공 데이터 수집용 키. scripts/fetch_public_data.py 가 화면용 데이터(web/public/data)를 새로 받을 때만 씁니다. 두 API 모두 무료입니다.
# 기업마당 지원사업정보 API (https://www.bizinfo.go.kr 에서 신청)
BIZINFO_API_KEY=your-bizinfo-api-key-here
# 한국벤처투자 펀드현황 API (https://www.kvic.or.kr 에서 신청)
KVIC_API_KEY=your-kvic-api-key-here
