# --- 비밀정보 / 로컬 환경 (절대 커밋 금지) ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# --- 실행 산출물 (실제 API 응답·제3자 기사 발췌·기자 이메일 등 포함 가능) ---
results/*
!results/.gitkeep
logs/
*.log
*.tmp
*.swp
*~

# --- 예시 회사 파일 (실제 기업의 공개자료 조회 결과라 저장소에 넣지 않는다. 이 파일이 있을 때만 화면에 "예시 회사로 체험" 단추가 나온다) ---
web/public/data/sample-company.json

# --- Streamlit / 로컬 도구 ---
.streamlit/secrets.toml
.streamlit/config.toml
.claude/settings.local.json

# --- OS / 에디터 ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- 향후 웹 프론트엔드(Next.js) 대비 ---
node_modules/
.next/

# --- 로컬 진단·분석 결과(실측 기록, 기사 발췌 포함 가능) ---
analysis_*.json
