# --- 비밀정보 / 로컬 환경 (절대 커밋 금지) ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Python ---
__pycache__/
*.py[cod]
.venv
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# --- 실행 산출물 (실제 API 응답·제3자 기사 발췌·기자 이메일 등 포함 가능) ---
results/*
!results/.gitkeep
logs/
*.log
*.tmp
*.swp
*~

# --- 옛 예시 회사 파일 (실제 기업의 공개자료 조회 결과라 저장소에 넣지 않는다. 지금 화면은 쓰지 않지만 로컬 복사본이 남아 있을 수 있어 계속 막는다) ---
web/public/data/sample-company.json

# --- 로컬 도구 ---
.claude/settings.local.json
# 지운 옛 검증 화면의 키 파일. 그 화면을 쓰던 복사본에 남아 있을 수 있어 계속 막는다
.streamlit/secrets.toml

# --- OS / 에디터 ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- 웹 화면(Next.js) ---
node_modules/
.next/

# --- 로컬 진단·분석 결과(실측 기록, 기사 발췌 포함 가능) ---
analysis_*.json
